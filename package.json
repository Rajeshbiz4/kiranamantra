{
  "name": "kiranamitra",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "type": "module",
  "description": "Offline-first Kirana store billing, inventory and GST desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node init && vite --host 127.0.0.1",
    "dev:electron": "node init && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node init && vite build",
    "dist:win": "node scripts/build-windows.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "license:generate": "node scripts/generate-license.cjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "6.4.0",
    "@mui/material": "6.4.0",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "electron": "34.0.2",
    "electron-builder": "25.1.8",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.kiranamitra.desktop",
    "productName": "KiranaMitra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "KiranaMitra-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
